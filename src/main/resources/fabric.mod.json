{
  "schemaVersion": 1,
  "id": "skillcraft",
  "version": "${version}",
  "name": "SkillCraft",
  "description": "Adds runescape-like skills to minecraft which give various buffs!",
  "authors": [
    "CamperScrub"
  ],
  "contact": {
    "homepage": "https://github.com/CamperScrub/skillcraft",
    "sources": "https://github.com/CamperScrub/skillcraft"
  },
  "license": "CC0-1.0",
  "icon": "assets/skillcraft/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.camperscrub.skillcraft.SkillCraft"
    ],
    "client": [
      "com.camperscrub.skillcraft.client.SkillCraftClient"
    ]
  },
  "mixins": [
    "skillcraft.mixins.json",
    {
      "config": "skillcraft.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.20.1",
    "minecraft": "~26.3",
    "java": ">=25",
    "fabric-api": "*"
  }
}